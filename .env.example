# Creative Brief Generator - Environment Variables
# Copy this file to .env.local for local development
# Add these variables to Netlify environment settings

# =====================================================
# REQUIRED: Supabase Configuration
# =====================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =====================================================
# REQUIRED: At least ONE AI Provider API Key
# =====================================================
# OpenAI (Preferred for /api/create-brief) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (Fallback) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini (Optional)
GEMINI_API_KEY=

# =====================================================
# OPTIONAL: Additional Services
# =====================================================
# Manus - https://manus.ai/
MANUS_API_KEY=

# n8n - For workflow automation
N8N_API_KEY=

# =====================================================
# NETLIFY DEPLOYMENT
# =====================================================
# 1. Go to Site Settings > Environment Variables
# 2. Add all REQUIRED variables above
# 3. The /api/create-brief endpoint uses server-side keys
# 4. Client-side briefs still use localStorage keys
